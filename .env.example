# URL du projet Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://VOTRE-PROJET.supabase.co

# Clé publique anon / publishable (Project Settings > API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=VOTRE_CLE_PUBLIQUE_ANON

# Clé secrète service_role : NE JAMAIS mettre NEXT_PUBLIC_ devant cette variable
SUPABASE_SERVICE_ROLE_KEY=VOTRE_CLE_SERVICE_ROLE

# Code secret fort choisi par l'administrateur
ADMIN_ACCESS_CODE=REMPLACER_PAR_UN_CODE_LONG_ET_DIFFICILE_A_DEVINER
